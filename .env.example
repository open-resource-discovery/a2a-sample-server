# Server Configuration
PORT=3000
SERVER_URL=http://localhost:3000

# Authentication for protected agents
# API Key for agents using apiKey security scheme (code-reviewer, storyteller)
AUTH_API_KEY=your-secret-api-key

# Basic Auth credentials for agents using http/basic scheme (chef)
AUTH_BASIC_USER=admin
AUTH_BASIC_PASS=secret

# OAuth Configuration (for OAuth2-protected agents like dad-jokes)
# Enable OAuth mock server
OAUTH_ENABLED=true

# Default OAuth client credentials (optional - test-client/test-secret always available)
OAUTH_CLIENT_ID=my-client
OAUTH_CLIENT_SECRET=my-secret

# OAuth issuer (defaults to SERVER_URL)
OAUTH_ISSUER=http://localhost:3000

# JWT secret for signing tokens (auto-generated if not set)
OAUTH_JWT_SECRET=your-jwt-secret-key

# Token expiry in seconds (default: 3600 = 1 hour)
OAUTH_TOKEN_EXPIRY_SECONDS=3600
