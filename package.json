{
  "name": "@open-resource-discovery/a2a-sample-server",
  "version": "0.1.0",
  "description": "A server to spin up several A2A endpoints for testing and development purposes",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint src/",
    "eslint:fix": "eslint src/ --fix",
    "prettier": "prettier --write \"src/**/*.ts\" \"*.json\"",
    "prettier:check": "prettier --check \"src/**/*.ts\" \"*.json\"",
    "test:ci": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "check": "npm run typecheck && npm run eslint && npm run prettier:check && npm run test:ci"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "dotenv": "^17.3.1",
    "express": "5.2.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@sap/eslint-config": "0.5.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.5",
    "@types/supertest": "7.2.1",
    "eslint": "10.9.1",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
