{
  "name": "@open-resource-discovery/a2a-sample-server",
  "version": "0.1.1",
  "description": "A server to spin up several A2A endpoints for testing and development purposes",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "24.22.x"
  },
  "scripts": {
    "build": "tsc",
    "heroku-postbuild": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "eslint": "npm run lint",
    "eslint:fix": "npm run lint:fix",
    "prettier": "npm run format",
    "prettier:check": "npm run format:check",
    "test:ci": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "check": "npm run typecheck && npm run eslint && npm run prettier:check && npm run test:ci",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write . && oxfmt --no-error-on-unmatched-pattern '**/*.{md,yml,yaml,css,scss,html}'",
    "format:check": "biome format . && oxfmt --check --no-error-on-unmatched-pattern '**/*.{md,yml,yaml,css,scss,html}'",
    "check:tooling": "npm run lint && npm run format:check"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "dotenv": "^18.0.9",
    "express": "5.3.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.9",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@biomejs/biome": "2.6.4",
    "oxfmt": "0.75.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
