# Keep dependency installs locked and save future additions as exact versions.
package-lock=true
save-exact=true

# Enforce the declared runtime requirements and verify registry TLS.
engine-strict=true
strict-ssl=true

# Block install lifecycle scripts; required build and setup steps run explicitly.
ignore-scripts=true

# Retain explicit package decisions as a guard if scripts are manually enabled.
strict-allow-scripts=true

# Delay newly published packages before ordinary resolutions.
min-release-age=2
